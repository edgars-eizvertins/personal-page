@page "/projects/{slug}"
@inject IContentStore Store
@inject NavigationManager Navigation

@if (_project is null)
{
    @* Router renders NotFoundPage; nothing to emit here. *@
}
else
{
    <PageMetadata Title="@_project.Title" Description="@Description" />

    <article class="page project">
        <PageHeader Title="@_project.Title" Meta="@ProjectDate">
            @if (!string.IsNullOrWhiteSpace(_project.FrontMatter.Summary))
            {
                <p class="page-summary">@_project.FrontMatter.Summary</p>
            }

            <TagList Tags="_project.FrontMatter.Tags" />

            @if (HasLinks)
            {
                <ProjectLinks Document="_project" Class="page-links" />
            }
        </PageHeader>

        @if (!string.IsNullOrWhiteSpace(_project.FrontMatter.Image))
        {
            <p class="project-image">
                <img src="@_project.FrontMatter.Image" alt="" loading="lazy" decoding="async" />
            </p>
        }

        <MarkdownBlock Html="@_project.Html" />

        <nav class="post-footer-nav" aria-label="Projects">
            <a href="/projects">All projects</a>
        </nav>
    </article>
}

@code {
    [Parameter]
    public string? Slug { get; set; }

    private ContentDocument? _project;

    private string? ProjectDate => _project?.SortDate is { } date ? DateText.Long(date) : null;

    private string? Description => _project?.FrontMatter.Summary ?? _project?.FrontMatter.Description;

    private bool HasLinks =>
        !string.IsNullOrWhiteSpace(_project?.FrontMatter.Repo)
        || !string.IsNullOrWhiteSpace(_project?.FrontMatter.Url);

    protected override async Task OnParametersSetAsync()
    {
        _project = await Store.GetItemAsync(ContentFolders.Projects, Slug);

        if (_project is null)
        {
            Navigation.NotFound();
        }
    }
}
