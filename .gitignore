# The site owner's real content is never tracked here.
# Start from the shipped examples:  cp -r content.example content
#
# No trailing slash: content/ may be a symlink to a private repo holding the real text
# rather than a directory, and a directory-only pattern would leave the link untracked-
# but-visible in git status.
content

# Local deployment settings (hostnames, IPs) stay out of the repo.
.env
*.local.env

# Source material for content (CV, notes). Personal, never tracked.
docs/Data/

# .NET build output
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
artifacts/
*.user
*.suo
*.userprefs
project.lock.json
project.fragment.lock.json

# Test / coverage output
[Tt]est[Rr]esult*/
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.trx

# Rider / Visual Studio / VS Code
.vs/
.idea/
*.sln.iml
.vscode/*
!.vscode/extensions.json

# OS noise
.DS_Store
Thumbs.db
*~

# Local Claude Code settings, not part of the project.
.claude/

# Python bytecode from the hub-readme script
__pycache__/
*.pyc
